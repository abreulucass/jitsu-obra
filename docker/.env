# =========================================================================
# CONFIGURAÇÃO JITSU - AMBIENTE ESTÁVEL
# =========================================================================

# --- ORQUESTRAÇÃO ---
# Perfil padrão para subir todos os serviços necessários do Jitsu
COMPOSE_PROFILES=jitsu-services
# Versão das imagens (use 'latest' ou uma versão específica como '0.0.1')
RELEASE_TAG=latest

# --- REDE E PORTAS ---
# Porta em que o painel administrativo (Console) ficará acessível
CONSOLE_PORT=3004
# Outras portas internas (caso precise de acesso direto)
ROTOR_PORT=3401
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
REDPANDA_CONSOLE_PORT=11801

# --- LOGIN ADMINISTRATIVO (AUTO-SEEDING) ---
# Estas credenciais serão usadas para criar seu acesso no primeiro boot
SEED_USER_EMAIL=fake
SEED_USER_PASSWORD=fake
SEED_DEMO_CONFIGURATION=true

# --- SEGREDOS E TOKENS ---
# Senha mestra do PostgreSQL
POSTGRES_PASSWORD=123456789
# Token de comunicação do Console
CONSOLE_TOKEN=123456789
# Token para o serviço de carregamento de dados (Bulker)
BULKER_TOKEN=123456789
# Token para o gerenciador de sincronizações (Syncctl)
SYNCCTL_TOKEN=123456789

# --- SEGURANÇA E CRIPTOGRAFIA ---
# Segredo usado pelo 'juava' para gerar hashes de senha e tokens JWT
# Mantenha este valor fixo para evitar perda de acesso a sessões antigas
CONSOLE_TOKEN_SECRET=123456789

# --- BANCO DE DADOS ---
# Senha interna recomendada para o ClickHouse
CLICKHOUSE_PASSWORD=clickhouse-pass

# --- KAFKA/REDPANDA ---
# Compressão do Kafka (use 'none', 'gzip', 'snappy' ou 'lz4')
KAFKA_COMPRESSION_TYPE=none